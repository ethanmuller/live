# Copy this to .env and adjust as needed. Both `vite.config.mjs` and
# `server/index.js` read these via dotenv, so a real environment variable
# (e.g. set by Docker/docker-compose) always overrides the value here.

# Port the Express/Socket.IO backend listens on (also what Vite proxies
# /api and /socket.io to in dev). Defaults to 8009 in dev, 8008 in
# production (see server/index.js) if unset.
#PORT=8009

# Host the backend binds to.
#HOST=0.0.0.0

# Port the Vite dev server listens on. Only relevant to `npm run dev`.
#CLIENT_PORT=8008
