{
  "name": "live",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "prod-start": "cross-env NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-fileupload": "^1.5.2",
    "p5": "^1.3.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.4.1",
    "socket.io-client": "^4.0.1",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2",
    "vuex-persist": "^3.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.4",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.7",
    "vite": "^6.4.3"
  }
}
